# -------------------------------------------------------------
# UNIMART / VERCEL ENVIRONMENT VARIABLES
# -------------------------------------------------------------

# 1. PAYMENTS (PAYSTACK)
# You need the secret key to initialize and verify payments securely.
PAYSTACK_SECRET_KEY=sk_test_...

# 2. APP URL
# This is required by APIs (like Paystack webhooks/callbacks) to return to your site.
# When deploying on Vercel, you can set this to your Vercel production URL.
APP_URL=https://your-project.vercel.app

# 3. FIREBASE ADMIN (SERVER-SIDE)
# Required for secure server operations like ESCROW, Wallets, and Ledgers.
# Generate a new private key from Firebase Console -> Project Settings -> Service Accounts
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com
# IMPORTANT: When pasting FIREBASE_PRIVATE_KEY into Vercel, make sure you copy the entire string including "-----BEGIN PRIVATE KEY-----" and "-----END PRIVATE KEY-----". 
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# 4. CRON JOBS
# Used to secure automated endpoints (e.g., auto-release escrow actions).
# Generate a random secure string for this.
CRON_SECRET=your_super_secret_cron_key_here

# 5. GEMINI API (If used anywhere inside the app face/chat routes)
NEXT_PUBLIC_GEMINI_API_KEY=your_gemini_api_key_here

# -------------------------------------------------------------
# IMPORTANT NOTE FOR FIREBASE CLIENT CONFIGURATION:
# -------------------------------------------------------------
# Ensure that your client-side `firebase-config.json` file is correctly 
# populated with your public Firebase keys before you push/deploy to Vercel. 
# Alternatively, you can migrate `firebase-config.json` values into 
# NEXT_PUBLIC_ variables here if you prefer not to commit the JSON file.
